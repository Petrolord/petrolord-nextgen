{
 "LearningModeGate loading": "<div><div class=\"max-w-xl mx-auto p-8 text-center space-y-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-10 w-10 text-[#BFFF00] mx-auto\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg><h2 class=\"text-2xl font-bold text-white\">This course is locked</h2><div class=\"text-gray-400\">Enrol to open it.</div><div class=\"flex justify-center text-gray-500\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-5 w-5 animate-spin\"><path d=\"M21 12a9 9 0 1 1-6.219-8.56\"></path></svg></div></div></div>",
 "LearningModeGate activate": "<div><div class=\"max-w-xl mx-auto p-8 text-center space-y-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-10 w-10 text-[#BFFF00] mx-auto\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg><h2 class=\"text-2xl font-bold text-white\">This course is locked</h2><div class=\"text-gray-400\">Enrol to open it.</div><div class=\"space-y-3\"><p class=\"text-gray-200\">Your enrolment is active. One step remains: activate your account with a one-minute orientation and a short placement assessment, and this course opens.</p><div class=\"flex justify-center\"><a href=\"/dashboard/get-started?next=%2Fdashboard%2Fapps%2Fdca\"><button class=\"inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 h-10 px-4 py-2 bg-[#BFFF00] text-[#0F172A] hover:bg-[#A8E600] font-semibold\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 mr-1\"><path d=\"M22 10v6M2 10l10-5 10 5-10 5z\"></path><path d=\"M6 12v5c3 3 9 3 12 0v-5\"></path></svg> Activate account</button></a></div></div></div></div>",
 "LearningModeGate stalled": "<div><div class=\"max-w-xl mx-auto p-8 text-center space-y-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-10 w-10 text-[#BFFF00] mx-auto\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg><h2 class=\"text-2xl font-bold text-white\">This course is locked</h2><div class=\"text-gray-400\">Enrol to open it.</div><div class=\"space-y-3\"><p class=\"text-gray-200\">Your enrolment is active and your account is activated, but access did not resolve on this load. Try again; if it stays locked, contact support with the course name.</p><div class=\"flex justify-center gap-3\"><button class=\"inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 h-10 px-4 py-2 bg-[#BFFF00] text-[#0F172A] hover:bg-[#A8E600] font-semibold\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 mr-1\"><path d=\"M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8\"></path><path d=\"M21 3v5h-5\"></path><path d=\"M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16\"></path><path d=\"M8 16H3v5\"></path></svg> Try again</button><a href=\"/dashboard/enroll\"><button class=\"inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2 border-gray-600 text-gray-200\">My enrollments</button></a></div></div></div></div>",
 "LearningModeGate pending": "<div><div class=\"max-w-xl mx-auto p-8 text-center space-y-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-10 w-10 text-[#BFFF00] mx-auto\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg><h2 class=\"text-2xl font-bold text-white\">This course is locked</h2><div class=\"text-gray-400\">Enrol to open it.</div><div class=\"space-y-3\"><p class=\"text-gray-200\">Your enrolment is waiting for payment. Complete it from your enrollments and the course opens as soon as the payment is confirmed.</p><div class=\"flex justify-center\"><a href=\"/dashboard/enroll\"><button class=\"inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 h-10 px-4 py-2 bg-[#BFFF00] text-[#0F172A] hover:bg-[#A8E600] font-semibold\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 mr-1\"><rect width=\"20\" height=\"14\" x=\"2\" y=\"5\" rx=\"2\"></rect><line x1=\"2\" x2=\"22\" y1=\"10\" y2=\"10\"></line></svg> Complete payment</button></a></div></div></div></div>",
 "LearningModeGate enrol": "<div><div class=\"max-w-xl mx-auto p-8 text-center space-y-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-10 w-10 text-[#BFFF00] mx-auto\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg><h2 class=\"text-2xl font-bold text-white\">This course is locked</h2><div class=\"text-gray-400\">Enrol to open it.</div><div class=\"space-y-3\"><div class=\"flex justify-center gap-3\"><a href=\"/dashboard/enroll\"><button class=\"inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 h-10 px-4 py-2 bg-[#BFFF00] text-[#0F172A] hover:bg-[#A8E600] font-semibold\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 mr-1\"><path d=\"M22 10v6M2 10l10-5 10 5-10 5z\"></path><path d=\"M6 12v5c3 3 9 3 12 0v-5\"></path></svg> Enrol</button></a></div><p class=\"text-xs text-gray-500\">Sponsored by your employer? Your training lead assigns the seat; the course opens here as soon as it is assigned, with no enrolment step on your side.</p></div></div></div>",
 "LearningModeGate enrol and activate": "<div><div class=\"max-w-xl mx-auto p-8 text-center space-y-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-10 w-10 text-[#BFFF00] mx-auto\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg><h2 class=\"text-2xl font-bold text-white\">This course is locked</h2><div class=\"text-gray-400\">Enrol to open it.</div><div class=\"space-y-3\"><div class=\"flex justify-center gap-3\"><a href=\"/dashboard/enroll\"><button class=\"inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 h-10 px-4 py-2 bg-[#BFFF00] text-[#0F172A] hover:bg-[#A8E600] font-semibold\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 mr-1\"><path d=\"M22 10v6M2 10l10-5 10 5-10 5z\"></path><path d=\"M6 12v5c3 3 9 3 12 0v-5\"></path></svg> Enrol</button></a><a href=\"/dashboard/get-started?next=%2Fdashboard%2Fapps%2Fdca\"><button class=\"inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2 border-gray-600 text-gray-200\">Activate account <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 ml-1\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></a></div><p class=\"text-xs text-gray-500\">Sponsored by your employer? Your training lead assigns the seat; the course opens here as soon as it is assigned, with no enrolment step on your side.</p></div></div></div>",
 "DeepCourseBanner practice": "<div><div class=\"rounded-lg border text-card-foreground shadow-sm bg-[#1E293B] border-[#BFFF00]/40\"><div class=\"p-4 flex flex-wrap items-center justify-between gap-3\"><div class=\"flex items-center gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-6 w-6 text-[#BFFF00] shrink-0\"><path d=\"M22 10v6M2 10l10-5 10 5-10 5z\"></path><path d=\"M6 12v5c3 3 9 3 12 0v-5\"></path></svg><p class=\"text-gray-300 text-sm mb-0\">The full course is open: 6 modules, 26 lessons, about 6 hours of study, with module quizzes and a final exam that issues the certificate.</p></div><a href=\"/dashboard/apps/contracts/course/advanced\"><button class=\"inline-flex items-center justify-center whitespace-nowrap text-sm ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 h-9 rounded-md px-3 bg-[#BFFF00] text-[#0F172A] hover:bg-[#A8E600] font-semibold\">Open the course <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 ml-1\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></a></div></div></div>",
 "DeepCourseBanner engine": "<div><div class=\"rounded-lg border text-card-foreground shadow-sm bg-[#1E293B] border-[#BFFF00]/40\"><div class=\"p-4 flex flex-wrap items-center justify-between gap-3\"><div class=\"flex items-center gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-6 w-6 text-[#BFFF00] shrink-0\"><path d=\"M22 10v6M2 10l10-5 10 5-10 5z\"></path><path d=\"M6 12v5c3 3 9 3 12 0v-5\"></path></svg><p class=\"text-gray-300 text-sm mb-0\">The full course is open: 6 modules, 26 lessons, about 6 hours of study, with module quizzes and a final exam before the capstone.</p></div><a href=\"/dashboard/apps/procurement/course/beginner\"><button class=\"inline-flex items-center justify-center whitespace-nowrap text-sm ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 h-9 rounded-md px-3 bg-[#BFFF00] text-[#0F172A] hover:bg-[#A8E600] font-semibold\">Open the course <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 ml-1\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></a></div></div></div>",
 "DeepCourseBanner none": "<div></div>",
 "panelKit": "<div><div class=\"rounded-lg border border-gray-700 bg-[#1E293B] p-4 space-y-4\"><div><p class=\"text-white font-semibold flex items-center gap-2 mb-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 text-[#BFFF00]\"><path d=\"M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2\"></path><path d=\"M8.5 2h7\"></path><path d=\"M7 16h10\"></path></svg> Archie explorer</p><p class=\"text-xs text-gray-400 mt-1 mb-0\">Move the inputs.</p></div><div class=\"grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5\"><div><label class=\"font-medium peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-gray-400 text-xs mb-1 block\">Porosity</label><input type=\"number\" class=\"flex w-full rounded-md border px-3 py-2 ring-offset-slate-950 file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#BFFF00] focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-gray-700 text-white border-gray-600 h-8 text-sm\" step=\"any\" placeholder=\"0.25\" value=\"0.2\"></div><div><label class=\"font-medium peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-gray-400 text-xs mb-1 block\">Lithology</label><select class=\"w-full bg-gray-700 text-white border border-gray-600 rounded-md h-8 text-sm px-2\"><option value=\"ss\">Sandstone</option><option value=\"ls\">Limestone</option></select></div></div><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-4 text-sm\"><div class=\"rounded-md border border-gray-700 bg-[#0F172A] p-3\"><p class=\"text-gray-500 text-xs mb-0\">Sw</p><p class=\"text-white mb-0\">0.35<span class=\"text-gray-400 text-xs ml-1\">v/v</span></p></div><div class=\"rounded-md border border-gray-700 bg-[#0F172A] p-3\"><p class=\"text-gray-500 text-xs mb-0\">Bulk volume water</p><p class=\"text-white mb-0\">0.07</p></div></div><p class=\"text-xs text-gray-500 mt-1 mb-0\">Archie holds in clean rock.</p></div></div>",
 "PanelShell no subtitle": "<div><div class=\"rounded-lg border border-gray-700 bg-[#1E293B] p-4 space-y-4\"><div><p class=\"text-white font-semibold flex items-center gap-2 mb-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 text-[#BFFF00]\"><path d=\"M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2\"></path><path d=\"M8.5 2h7\"></path><path d=\"M7 16h10\"></path></svg> Plain</p></div>body</div></div>",
 "CapstoneCaseFiles": "<div><div class=\"rounded-md border border-gray-700 bg-[#0F172A] p-3 space-y-2\" data-testid=\"capstone-case-files\"><p class=\"text-white text-sm font-medium mb-0\">Capstone case files</p><p class=\"text-xs text-gray-400 mb-0\">Open them in the panels.</p><div class=\"flex flex-wrap gap-2\"><button type=\"button\" class=\"inline-flex items-center gap-1 px-3 py-1.5 rounded-md border border-gray-600 bg-gray-800 text-gray-200 text-xs hover:border-[#BFFF00]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-3 w-3 text-[#BFFF00]\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><polyline points=\"7 10 12 15 17 10\"></polyline><line x1=\"12\" x2=\"12\" y1=\"15\" y2=\"3\"></line></svg> case.csv</button><button type=\"button\" class=\"inline-flex items-center gap-1 px-3 py-1.5 rounded-md border border-gray-600 bg-gray-800 text-gray-200 text-xs hover:border-[#BFFF00]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-3 w-3 text-[#BFFF00]\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><polyline points=\"7 10 12 15 17 10\"></polyline><line x1=\"12\" x2=\"12\" y1=\"15\" y2=\"3\"></line></svg> brief.txt</button></div></div></div>",
 "CapstoneCaseFiles no note": "<div><div class=\"rounded-md border border-gray-700 bg-[#0F172A] p-3 space-y-2\" data-testid=\"capstone-case-files\"><p class=\"text-white text-sm font-medium mb-0\">Capstone case files</p><div class=\"flex flex-wrap gap-2\"><button type=\"button\" class=\"inline-flex items-center gap-1 px-3 py-1.5 rounded-md border border-gray-600 bg-gray-800 text-gray-200 text-xs hover:border-[#BFFF00]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-3 w-3 text-[#BFFF00]\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><polyline points=\"7 10 12 15 17 10\"></polyline><line x1=\"12\" x2=\"12\" y1=\"15\" y2=\"3\"></line></svg> case.csv</button></div></div></div>",
 "LockedCard": "<div><div class=\"max-w-xl mx-auto p-8 text-center space-y-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-10 w-10 text-[#BFFF00] mx-auto\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg><h2 class=\"text-2xl font-bold text-white\">Locked</h2><p class=\"text-gray-400\">Pass the quiz first.</p><a href=\"/back\"><button class=\"inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2 border-gray-600 text-gray-200\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 mr-1\"><path d=\"m12 19-7-7 7-7\"></path><path d=\"M19 12H5\"></path></svg> Back to course</button></a></div></div>",
 "LockedCard bare": "<div><div class=\"max-w-xl mx-auto p-8 text-center space-y-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-10 w-10 text-[#BFFF00] mx-auto\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg><h2 class=\"text-2xl font-bold text-white\">Locked</h2></div></div>",
 "QuizRunner loading": "<div><div class=\"flex items-center justify-center h-64\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-8 w-8 animate-spin text-[#BFFF00]\"><path d=\"M21 12a9 9 0 1 1-6.219-8.56\"></path></svg></div></div>",
